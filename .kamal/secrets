# Este archivo SI se versiona: no contiene contrasenas, solo dice de
# donde sacarlas. Nunca escribas un valor literal aca.
#
# Antes de desplegar, exporta las dos variables en tu terminal:
#
#   export KAMAL_REGISTRY_PASSWORD='tu-token-del-registro'
#   export DB_PASSWORD='una-contrasena-larga-y-aleatoria'
#
# Para generar una:  openssl rand -base64 32

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# La clave que descifra config/credentials.yml.enc.
# config/master.key esta en .gitignore y NUNCA se sube al repositorio.
RAILS_MASTER_KEY=$(cat config/master.key)

# La misma contrasena para las dos: una la usa PostgreSQL al crearse,
# la otra la usa Rails al conectarse.
POSTGRES_PASSWORD=$DB_PASSWORD
CONTROL_COSTOS_DATABASE_PASSWORD=$DB_PASSWORD
