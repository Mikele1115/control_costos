<% clases_campo = "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>

<%= form_with model: proveedor, class: "space-y-5" do |f| %>
  <% if proveedor.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 p-4">
      <p class="text-sm font-semibold text-rose-900">
        No se pudo guardar (<%= pluralize(proveedor.errors.count, "error") %>)
      </p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-rose-800">
        <% proveedor.errors.full_messages.each do |mensaje| %>
          <li><%= mensaje %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :nombre, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :nombre, class: clases_campo, autofocus: true, placeholder: "Nestlé" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :contacto, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :contacto, class: clases_campo, placeholder: "Ana Ruiz" %>
    </div>
    <div>
      <%= f.label :telefono, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :telefono, class: clases_campo, placeholder: "2 2345 6789" %>
    </div>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
    <%= link_to "Cancelar", proveedor.persisted? ? proveedor : proveedores_path,
          class: "text-sm text-slate-500 hover:underline" %>
  </div>
<% end %>
