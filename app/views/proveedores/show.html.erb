<% content_for :title, @proveedor.nombre %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <%= link_to "← Proveedores", proveedores_path, class: "text-sm text-slate-500 hover:underline" %>
    <h1 class="mt-1 text-2xl font-bold text-slate-900"><%= @proveedor.nombre %></h1>
    <p class="mt-1 text-sm text-slate-500">
      <% if @proveedor.contacto.present? || @proveedor.telefono.present? %>
        <%= [@proveedor.contacto.presence, @proveedor.telefono.presence].compact.join(" · ") %>
      <% else %>
        Sin datos de contacto
      <% end %>
    </p>
  </div>
  <% if puede_escribir? %>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Editar", edit_proveedor_path(@proveedor),
            class: "rounded-md border border-slate-300 px-3 py-2 text-sm font-medium hover:bg-slate-50" %>
      <%= button_to "Eliminar", @proveedor, method: :delete,
            form: { data: { turbo_confirm: "¿Eliminar #{@proveedor.nombre}? Sus #{@proveedor.cantidad_insumos} insumos quedarán sin proveedor." } },
            class: "cursor-pointer rounded-md border border-rose-300 px-3 py-2 text-sm font-medium text-rose-700 hover:bg-rose-50" %>
    </div>
  <% end %>
</div>

<h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">
  Insumos que provee (<%= @insumos.size %>)
</h2>

<% if @insumos.any? %>
  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-3 text-left font-medium">Insumo</th>
          <th class="px-4 py-3 text-left font-medium">Unidad base</th>
          <th class="px-4 py-3 text-right font-medium">Merma</th>
          <th class="px-4 py-3 text-right font-medium">Costo actual</th>
          <th class="px-4 py-3 text-right font-medium">Con merma</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @insumos.each do |insumo| %>
          <% unitario = insumo.costo_unitario %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-medium text-slate-900">
              <%= link_to insumo.nombre, insumo, class: "hover:underline" %>
            </td>
            <td class="px-4 py-3 text-slate-500"><%= insumo.unidad_base %></td>
            <td class="px-4 py-3 text-right text-slate-500">
              <%= insumo.merma_porcentaje.positive? ? "#{cantidad(insumo.merma_porcentaje)} %" : "—" %>
            </td>
            <td class="px-4 py-3 text-right">
              <%= unitario ? moneda(unitario) : content_tag(:span, "sin precio", class: "text-xs text-amber-700") %>
            </td>
            <td class="px-4 py-3 text-right text-slate-500">
              <%= unitario ? moneda(unitario * insumo.factor_merma) : "—" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="rounded-lg border border-slate-200 bg-white px-4 py-6 text-center text-sm text-slate-500">
    Este proveedor todavía no tiene insumos asignados.
    Se asignan desde la ficha de cada insumo.
  </div>
<% end %>
