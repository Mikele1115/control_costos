<% content_for :title, "Proveedores" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Proveedores</h1>
    <p class="mt-1 text-sm text-slate-500"><%= pluralize(@proveedores.size, "proveedor") %></p>
  </div>
  <% if puede_escribir? %>
    <%= link_to "Nuevo proveedor", new_proveedor_path,
          class: "rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
  <% end %>
</div>

<% if @proveedores.any? %>
  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-3 text-left font-medium">Proveedor</th>
          <th class="px-4 py-3 text-left font-medium">Contacto</th>
          <th class="px-4 py-3 text-left font-medium">Teléfono</th>
          <th class="px-4 py-3 text-right font-medium">Insumos</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @proveedores.each do |proveedor| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-medium text-slate-900">
              <%= link_to proveedor.nombre, proveedor, class: "hover:underline" %>
            </td>
            <td class="px-4 py-3 text-slate-500"><%= proveedor.contacto.presence || "—" %></td>
            <td class="px-4 py-3 text-slate-500"><%= proveedor.telefono.presence || "—" %></td>
            <td class="px-4 py-3 text-right"><%= proveedor.cantidad_insumos %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="rounded-lg border border-slate-200 bg-white px-4 py-8 text-center">
    <p class="text-sm text-slate-500">Todavía no cargaste ningún proveedor.</p>
    <% if puede_escribir? %>
      <%= link_to "Crear el primero", new_proveedor_path,
            class: "mt-2 inline-block text-sm font-medium text-slate-900 underline" %>
    <% end %>
  </div>
<% end %>

<% if @sin_proveedor.any? %>
  <div class="mt-8 rounded-lg border border-slate-200 bg-white p-4">
    <p class="text-sm font-medium text-slate-700">
      <%= pluralize(@sin_proveedor.size, "insumo") %> sin proveedor asignado
    </p>
    <p class="mt-2 text-sm text-slate-500">
      <%= safe_join(@sin_proveedor.map { |i| link_to i.nombre, i, class: "underline hover:text-slate-900" }, ", ") %>
    </p>
  </div>
<% end %>
