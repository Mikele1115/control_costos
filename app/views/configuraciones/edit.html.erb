<% content_for :title, "Ajustes" %>
<% clases_campo = "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>
<% clases_boton_chico = "cursor-pointer rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50" %>

<div class="mx-auto max-w-lg space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Ajustes</h1>
    <p class="mt-1 text-sm text-slate-500">
      Cuándo y a quién avisamos si, al cargar un precio nuevo, algún plato empeora su food cost.
    </p>
  </div>

  <section class="rounded-lg border border-slate-200 bg-white p-6">
    <h2 class="mb-4 text-xs font-semibold uppercase tracking-wide text-slate-400">Cuándo avisar</h2>

    <%= form_with model: @configuracion, url: configuracion_path, method: :patch, class: "space-y-5" do |f| %>
      <% if @configuracion.errors.any? %>
        <div class="rounded-lg border border-rose-200 bg-rose-50 p-4">
          <p class="text-sm font-semibold text-rose-900">
            No se pudo guardar (<%= pluralize(@configuracion.errors.count, "error") %>)
          </p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-rose-800">
            <% @configuracion.errors.full_messages.each do |mensaje| %>
              <li><%= mensaje %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :umbral_aviso, class: "block text-sm font-medium text-slate-700" %>
        <div class="relative">
          <%= f.number_field :umbral_aviso, step: 0.5, min: 0.5, max: 100,
                class: clases_campo + " pr-8" %>
          <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-400">%</span>
        </div>
        <p class="mt-1 text-xs text-slate-500">
          Te avisamos cuando un plato llega a este número o lo pasa. Si ya estaba por encima, solo si además empeora de banda: un aviso que se repite en cada carga de precio se termina ignorando.
        </p>
      </div>

      <label class="flex cursor-pointer items-start gap-3 rounded-md bg-slate-50 p-3">
        <%= f.check_box :avisos_activos,
              class: "mt-0.5 h-4 w-4 cursor-pointer rounded border-slate-300 text-slate-900 focus:ring-slate-900" %>
        <span class="text-sm text-slate-700">
          <span class="font-medium">Avisar por correo</span>
          <span class="block text-xs text-slate-500">Apaga todos los avisos de golpe, sin tocar la lista de abajo.</span>
        </span>
      </label>

      <div class="pt-1">
        <%= f.submit "Guardar", class: "cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
      </div>
    <% end %>
  </section>

  <section class="rounded-lg border border-slate-200 bg-white p-6">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-400">A quién avisar</h2>

    <% if @destinatarios.any? %>
      <ul class="mt-3 divide-y divide-slate-100">
        <% @destinatarios.each do |destinatario| %>
          <li class="flex items-center justify-between gap-3 py-3">
            <div class="min-w-0">
              <p class="truncate text-sm <%= destinatario.activo? ? "text-slate-900" : "text-slate-400 line-through" %>">
                <%= destinatario.correo %>
              </p>
              <p class="text-xs text-slate-400">
                <% if destinatario.activo? %>
                  En la lista desde el <%= l(destinatario.created_at.to_date, format: :long) %>
                <% else %>
                  Desactivado el <%= l(destinatario.updated_at.to_date, format: :long) %>
                <% end %>
              </p>
            </div>

            <div class="flex shrink-0 items-center gap-2">
              <%= button_to (destinatario.activo? ? "Desactivar" : "Activar"),
                    destinatario_path(destinatario), method: :patch, class: clases_boton_chico %>
              <%= button_to "Quitar", destinatario_path(destinatario), method: :delete,
                    class: "cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-slate-400 hover:bg-rose-50 hover:text-rose-700",
                    form: { data: { turbo_confirm: "¿Quitar a #{destinatario.correo} de la lista? Se pierde el registro de que estuvo." } } %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-900">
        No hay nadie en la lista, así que no sale ningún aviso.
      </p>
    <% end %>

    <%= form_with model: @destinatario, class: "mt-5 border-t border-slate-100 pt-5" do |f| %>
      <% if @destinatario.errors.any? %>
        <ul class="mb-3 list-disc space-y-1 pl-5 text-sm text-rose-800">
          <% @destinatario.errors.full_messages.each do |mensaje| %>
            <li><%= mensaje %></li>
          <% end %>
        </ul>
      <% end %>

      <%= f.label :correo, "Agregar un correo", class: "block text-sm font-medium text-slate-700" %>
      <div class="mt-1 flex gap-2">
        <%= f.email_field :correo, placeholder: "chef@lasplendida.cl",
              class: "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>
        <%= f.submit "Agregar", class: "shrink-0 cursor-pointer rounded-md border border-slate-900 px-4 py-2 text-sm font-medium text-slate-900 hover:bg-slate-900 hover:text-white" %>
      </div>
      <p class="mt-1 text-xs text-slate-500">
        Desactivar deja el correo en la lista como registro; quitar lo borra.
      </p>
    <% end %>
  </section>

  <section class="rounded-lg border border-slate-200 bg-white p-6">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-400">Quién entra</h2>

    <ul class="mt-3 divide-y divide-slate-100">
      <% @usuarios.each do |usuario| %>
        <li class="flex items-center justify-between gap-3 py-3">
          <div class="min-w-0">
            <p class="truncate text-sm text-slate-900">
              <%= usuario.email_address %>
              <% if usuario == Current.user %>
                <span class="ml-1 rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-500">tú</span>
              <% end %>
            </p>
            <p class="text-xs text-slate-400"><%= t("usuarios.descripciones.#{usuario.rol}") %></p>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <% if usuario == Current.user %>
              <%# Nadie se cambia el rol ni se borra a si mismo: con esa %>
              <%# sola regla siempre sobrevive un administrador. %>
              <span class="text-xs font-medium text-slate-500">
                <%= t("usuarios.roles.#{usuario.rol}") %>
              </span>
            <% else %>
              <%= form_with model: usuario, url: user_path(usuario), method: :patch,
                    class: "flex items-center gap-1.5" do |f| %>
                <%= f.select :rol, User::ROLES.map { |rol| [t("usuarios.roles.#{rol}"), rol] }, {},
                      class: "cursor-pointer rounded-md border border-slate-300 px-2 py-1 text-xs" %>
                <%= f.submit "Cambiar", class: "cursor-pointer rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50" %>
              <% end %>
              <%= button_to "Quitar", user_path(usuario), method: :delete,
                    class: "cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-slate-400 hover:bg-rose-50 hover:text-rose-700",
                    form: { data: { turbo_confirm: "¿Eliminar la cuenta de #{usuario.email_address}?" } } %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>

    <%= form_with model: @usuario_nuevo, url: users_path, class: "mt-5 space-y-3 border-t border-slate-100 pt-5" do |f| %>
      <% if @usuario_nuevo.errors.any? %>
        <ul class="list-disc space-y-1 pl-5 text-sm text-rose-800">
          <% @usuario_nuevo.errors.full_messages.each do |mensaje| %>
            <li><%= mensaje %></li>
          <% end %>
        </ul>
      <% end %>

      <p class="text-sm font-medium text-slate-700">Crear una cuenta</p>

      <div class="grid grid-cols-2 gap-2">
        <%= f.email_field :email_address, placeholder: "chef@lasplendida.cl",
              class: "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>
        <%= f.password_field :password, placeholder: "Contraseña inicial", autocomplete: "new-password",
              class: "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>
      </div>

      <div class="flex gap-2">
        <%= f.select :rol, User::ROLES.map { |rol| [t("usuarios.roles.#{rol}"), rol] }, { selected: "digitador" },
              class: "block w-full cursor-pointer rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        <%= f.submit "Crear", class: "shrink-0 cursor-pointer rounded-md border border-slate-900 px-4 py-2 text-sm font-medium text-slate-900 hover:bg-slate-900 hover:text-white" %>
      </div>
    <% end %>
  </section>
</div>

