<% content_for :title, t("autenticacion.titulo_login") %>
<% clases_campo = "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>

<div class="mx-auto max-w-sm">
  <h1 class="mb-6 text-2xl font-bold text-slate-900"><%= t("autenticacion.titulo_login") %></h1>

  <div class="rounded-lg border border-slate-200 bg-white p-6">
    <%= form_with url: session_url, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :email_address, t("autenticacion.correo"),
              class: "block text-sm font-medium text-slate-700" %>
        <%= f.email_field :email_address, required: true, autofocus: true,
              autocomplete: "username", value: params[:email_address],
              class: clases_campo %>
      </div>

      <div>
        <%= f.label :password, t("autenticacion.contrasena"),
              class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :password, required: true,
              autocomplete: "current-password", maxlength: 72,
              class: clases_campo %>
      </div>

      <div class="flex items-center justify-between gap-3 pt-2">
        <%= f.submit t("autenticacion.entrar"),
              class: "cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
        <%= link_to t("autenticacion.olvide"), new_password_path,
              class: "text-sm text-slate-500 hover:underline" %>
      </div>
    <% end %>
  </div>
</div>
