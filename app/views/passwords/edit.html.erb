<% content_for :title, t("autenticacion.titulo_nueva") %>
<% clases_campo = "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>

<div class="mx-auto max-w-sm">
  <h1 class="mb-6 text-2xl font-bold text-slate-900"><%= t("autenticacion.titulo_nueva") %></h1>

  <div class="rounded-lg border border-slate-200 bg-white p-6">
    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :password, t("autenticacion.contrasena_nueva"),
              class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :password, required: true, autofocus: true,
              autocomplete: "new-password", maxlength: 72, class: clases_campo %>
      </div>

      <div>
        <%= f.label :password_confirmation, t("autenticacion.contrasena_repetir"),
              class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :password_confirmation, required: true,
              autocomplete: "new-password", maxlength: 72, class: clases_campo %>
      </div>

      <div class="pt-2">
        <%= f.submit t("autenticacion.guardar"),
              class: "cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
      </div>
    <% end %>
  </div>
</div>
