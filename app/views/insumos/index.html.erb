<% content_for :title, "Insumos" %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Insumos</h1>
    <p class="mt-1 text-sm text-slate-500">
      <%= pluralize(@total, "insumo") %> ·
      <%= pluralize(Proveedor.count, "proveedor") %>
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= form_with url: insumos_path, method: :get, class: "flex items-center gap-2" do |f| %>
      <%= f.search_field :q, value: @busqueda,
            placeholder: "Buscar por nombre o proveedor…",
            class: "w-64 rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>
      <%= f.submit "Buscar",
            class: "cursor-pointer rounded-md border border-slate-300 px-3 py-2 text-sm font-medium hover:bg-slate-50" %>
    <% end %>
    <% if puede_escribir? %>
      <%= link_to "Nuevo insumo", new_insumo_path,
            class: "rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
    <% end %>
  </div>
</div>

<% if @busqueda.present? %>
  <div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
    <span class="text-slate-600">
      <%= pluralize(@insumos.size, "resultado") %> para «<strong class="text-slate-900"><%= @busqueda %></strong>»
    </span>
    <%= link_to "limpiar", insumos_path, class: "text-slate-400 underline hover:text-slate-700" %>
  </div>
<% end %>

<% if @grupos.empty? %>
  <div class="rounded-lg border border-slate-200 bg-white px-4 py-10 text-center">
    <p class="text-sm text-slate-500">
      Ningún insumo coincide con «<strong class="text-slate-700"><%= @busqueda %></strong>».
    </p>
    <%= link_to "Ver todos los insumos", insumos_path,
          class: "mt-2 inline-block text-sm font-medium text-slate-900 underline" %>
  </div>
<% end %>

<% @grupos.each do |proveedor, insumos| %>
  <section class="mb-8">
    <div class="mb-3 flex items-baseline gap-3">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
        <% if proveedor %>
          <%= link_to proveedor.nombre, proveedor, class: "hover:underline" %>
        <% else %>
          Sin proveedor
        <% end %>
      </h2>
      <span class="text-xs text-slate-400"><%= pluralize(insumos.size, "insumo") %></span>
    </div>

    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-3 text-left font-medium">Nombre</th>
            <th class="px-4 py-3 text-left font-medium">Unidad base</th>
            <th class="px-4 py-3 text-right font-medium">Merma</th>
            <th class="px-4 py-3 text-right font-medium">Costo actual</th>
            <th class="px-4 py-3 text-right font-medium">Con merma</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% insumos.each do |insumo| %>
            <% unitario = insumo.costo_unitario %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-3 font-medium text-slate-900">
                <%= link_to insumo.nombre, insumo, class: "hover:underline" %>
              </td>
              <td class="px-4 py-3 text-slate-500"><%= insumo.unidad_base %></td>
              <td class="px-4 py-3 text-right">
                <% if insumo.merma_porcentaje.positive? %>
                  <span class="rounded bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-900">
                    <%= cantidad(insumo.merma_porcentaje) %> %
                  </span>
                <% else %>
                  <span class="text-slate-300">—</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right">
                <% if unitario %>
                  <%= moneda(unitario) %>
                  <span class="text-xs text-slate-400">/ <%= insumo.unidad_base %></span>
                <% else %>
                  <span class="text-xs text-amber-700">sin precio</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right text-slate-500">
                <%= unitario ? moneda(unitario * insumo.factor_merma) : "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
