<% grafico = GraficoPrecios.new(precios) %>

<% unless grafico.vacio? %>
  <div class="mb-8 rounded-lg border border-slate-200 bg-white p-5">
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
        Evolución del precio
      </h2>
      <p class="text-xs text-slate-400">
        <%= pluralize(grafico.puntos.size, "precio") %> ·
        <%= l(grafico.desde) %> — <%= l(grafico.hasta) %>
        <% if grafico.variacion %>
          ·
          <span class="<%= grafico.variacion.positive? ? 'text-rose-600' : 'text-emerald-600' %> font-medium">
            <%= grafico.variacion.positive? ? "+" : "" %><%= cantidad(grafico.variacion, 1) %> %
          </span>
        <% end %>
      </p>
    </div>

    <svg viewBox="0 0 <%= grafico.ancho %> <%= grafico.alto %>"
         class="w-full" role="img"
         aria-label="Evolución del costo por <%= insumo.unidad_base %> de <%= insumo.nombre %>">

      <% grafico.lineas_guia.each do |valor, y| %>
        <line x1="<%= grafico.x_izquierda %>" y1="<%= y %>"
              x2="<%= grafico.x_derecha %>"   y2="<%= y %>"
              stroke="#e2e8f0" stroke-width="1" />
        <text x="<%= grafico.x_izquierda - 8 %>" y="<%= y + 3 %>"
              text-anchor="end" font-size="10" fill="#94a3b8">
          <%= moneda(valor) %>
        </text>
      <% end %>

      <path d="<%= grafico.ruta %>" fill="none" stroke="#0f172a"
            stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />

      <% grafico.puntos.each do |punto| %>
        <circle cx="<%= punto[:x] %>" cy="<%= punto[:y] %>" r="3.5" fill="#0f172a">
          <title><%= l(punto[:fecha]) %>: <%= moneda(punto[:valor]) %> por <%= insumo.unidad_base %></title>
        </circle>
      <% end %>

      <text x="<%= grafico.x_izquierda %>" y="<%= grafico.alto - 8 %>"
            font-size="10" fill="#94a3b8"><%= l(grafico.desde) %></text>
      <text x="<%= grafico.x_derecha %>" y="<%= grafico.alto - 8 %>"
            text-anchor="end" font-size="10" fill="#94a3b8"><%= l(grafico.hasta) %></text>
    </svg>

    <p class="mt-3 text-xs text-slate-500">
      La línea es una escalera: cada precio rige tal cual hasta que se
      carga el siguiente. Pasá el cursor por los puntos para ver el detalle.
    </p>
  </div>
<% end %>
