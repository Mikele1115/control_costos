<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Control de Costos La Splendida" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
    <header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4">
        <%= link_to root_path, class: "flex items-center gap-2 font-semibold text-slate-900" do %>
          <span class="text-xl">🍕</span>
          <span>Control de Costos La Splendida</span>
        <% end %>

        <%# Sin sesion no hay a donde navegar: todo redirige al login. %>
        <% if authenticated? %>
          <nav class="flex items-center gap-1 text-sm font-medium">
            <%= enlace_nav "Panel",   root_path %>
            <%= enlace_nav "Insumos", insumos_path %>
            <%= enlace_nav "Proveedores", proveedores_path %>
            <%= enlace_nav "Recetas", recetas_path %>
            <%= enlace_nav "Márgenes", margenes_path %>
            <%= enlace_nav "Ajustes", edit_configuracion_path %>
            <%= button_to t("autenticacion.salir"), session_path, method: :delete,
                  class: "ml-2 cursor-pointer rounded-md px-3 py-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700" %>
          </nav>
        <% end %>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <% if notice.present? %>
        <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
          <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="mb-6 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-900">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
