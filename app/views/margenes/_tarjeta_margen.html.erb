<%# Recibe: titulo, fila %>
<div class="rounded-lg border border-slate-200 bg-white p-4">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="text-xs uppercase tracking-wide text-slate-500"><%= titulo %></p>
    <%= insignia_margen(fila[:margen_pct]) %>
  </div>

  <p class="mt-1 text-sm font-medium text-slate-900">
    <%= link_to fila[:plato].nombre, fila[:plato], class: "hover:underline" %>
  </p>

  <dl class="mt-3 space-y-1.5 border-t border-slate-100 pt-3 text-sm">
    <div class="flex items-baseline justify-between gap-2">
      <dt class="text-slate-500">Precio de venta</dt>
      <dd class="flex items-baseline gap-3">
        <span class="font-medium text-slate-900"><%= moneda(fila[:plato].precio_venta) %></span>
        <span class="w-16 text-right text-xs text-slate-400">100 %</span>
      </dd>
    </div>

    <div class="flex items-baseline justify-between gap-2">
      <dt class="text-slate-500">Costo de venta</dt>
      <dd class="flex items-baseline gap-3">
        <span class="font-medium text-slate-900"><%= moneda(fila[:costo]) %></span>
        <span class="w-16 text-right text-xs text-slate-400"><%= porcentaje(fila[:food_cost]) %></span>
      </dd>
    </div>

    <div class="flex items-baseline justify-between gap-2">
      <dt class="text-slate-500">Margen de venta</dt>
      <dd class="flex items-baseline gap-3">
        <span class="font-medium text-slate-900"><%= moneda(fila[:margen]) %></span>
        <span class="w-16 text-right text-xs text-slate-400"><%= porcentaje(fila[:margen_pct]) %></span>
      </dd>
    </div>
  </dl>
</div>
