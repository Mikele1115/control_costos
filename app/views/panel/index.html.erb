<% content_for :title, "Panel" %>

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Panel de costos</h1>
    <p class="mt-1 text-sm text-slate-500">
      Costeo al <%= l(@fecha, format: :long) %>
    </p>
  </div>

  <%= form_with url: root_path, method: :get, class: "flex items-end gap-2" do |f| %>
    <div>
      <%= f.label :fecha, "Ver costos a la fecha",
            class: "block text-xs font-medium text-slate-600" %>
      <%= f.date_field :fecha, value: @fecha,
            class: "mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm" %>
    </div>
    <%= f.submit "Aplicar",
          class: "cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
  <% end %>
</div>

<% if @alertas.any? %>
  <div class="mb-8 overflow-hidden rounded-lg border border-rose-200 bg-white">
    <div class="border-b border-rose-200 bg-rose-50 px-4 py-3">
      <p class="text-sm font-semibold text-rose-900">
        <% if @alertas.one? %>
          Un plato necesita atención
        <% else %>
          <%= @alertas.size %> platos necesitan atención
        <% end %>
      </p>
      <p class="mt-0.5 text-xs text-rose-800">
        Su food cost supera el <%= Receta::UMBRAL_ALTO %> %: la materia prima
        se lleva demasiado del precio de venta.
      </p>
    </div>

    <ul class="divide-y divide-slate-100">
      <% @alertas.each do |alerta| %>
        <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
          <div class="flex flex-wrap items-center gap-3">
            <%= insignia_food_cost(alerta[:food_cost]) %>
            <%= link_to alerta[:plato].nombre, alerta[:plato],
                  class: "text-sm font-medium text-slate-900 hover:underline" %>
            <span class="text-xs text-slate-400"><%= alerta[:plato].categoria_etiqueta %></span>
            <% if alerta[:banda] == :perdida %>
              <span class="rounded bg-rose-600 px-1.5 py-0.5 text-xs font-semibold text-white">
                se vende bajo costo
              </span>
            <% end %>
          </div>
          <p class="text-sm text-slate-600">
            se vende a <%= moneda(alerta[:plato].precio_venta) %> ·
            debería valer <strong class="text-slate-900"><%= moneda(alerta[:sugerido]) %></strong>
            <span class="font-medium text-rose-700">(+<%= moneda(alerta[:brecha]) %>)</span>
          </p>
        </li>
      <% end %>
    </ul>

    <div class="border-t border-slate-100 px-4 py-2">
      <%= link_to "Ver el comparativo completo →", margenes_path(fecha: @fecha),
            class: "text-xs font-medium text-slate-600 hover:underline" %>
    </div>
  </div>
<% end %>

<% if @sin_precio.any? %>
  <div class="mb-8 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3">
    <p class="text-sm font-medium text-amber-900">
      <%= pluralize(@sin_precio.size, "insumo sin precio", "insumos sin precio") %>:
      cualquier receta que los use no se puede costear.
    </p>
    <p class="mt-1 text-sm text-amber-800">
      <%= safe_join(@sin_precio.map { |i| link_to i.nombre, insumo_path(i), class: "underline" }, ", ") %>
    </p>
  </div>
<% end %>

<% @grupos.each do |categoria, platos| %>
  <section class="mb-8">
    <div class="mb-3 flex items-baseline gap-3">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
        <%= categoria ? t("costeo.categorias.#{categoria}") : "Sin clasificar" %>
      </h2>
      <span class="text-xs text-slate-400"><%= pluralize(platos.size, "plato") %></span>
    </div>

    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-3 text-left font-medium">Plato</th>
            <th class="px-4 py-3 text-right font-medium">Costo</th>
            <th class="px-4 py-3 text-right font-medium">Precio venta</th>
            <th class="px-4 py-3 text-right font-medium">Margen</th>
            <th class="px-4 py-3 text-center font-medium">Food cost</th>
            <th class="px-4 py-3 text-right font-medium">PVP sugerido</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% platos.each do |plato| %>
            <% costeable = plato.costeable?(fecha: @fecha) %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-3 font-medium text-slate-900">
                <%= link_to plato.nombre, receta_path(plato), class: "hover:underline" %>
              </td>
              <% if costeable %>
                <td class="px-4 py-3 text-right"><%= moneda(plato.costo_total(fecha: @fecha)) %></td>
                <td class="px-4 py-3 text-right text-slate-500"><%= moneda(plato.precio_venta) %></td>
                <td class="px-4 py-3 text-right"><%= moneda(plato.margen_bruto(fecha: @fecha)) %></td>
                <td class="px-4 py-3 text-center"><%= insignia_food_cost(plato.food_cost(fecha: @fecha)) %></td>
                <td class="px-4 py-3 text-right text-slate-500"><%= moneda(plato.precio_sugerido(fecha: @fecha)) %></td>
              <% else %>
                <td colspan="5" class="px-4 py-3 text-center text-xs text-amber-700">
                  falta el precio de algún insumo
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<section>
  <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Preparaciones</h2>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @preparaciones.each do |prep| %>
      <%= link_to receta_path(prep),
            class: "block rounded-lg border border-slate-200 bg-white p-4 hover:border-slate-400" do %>
        <p class="font-medium text-slate-900"><%= prep.nombre %></p>
        <p class="mt-1 text-xs text-slate-500">
          rinde <%= cantidad(prep.rendimiento_cantidad) %> <%= prep.rendimiento_unidad %>
        </p>
        <% if prep.costeable?(fecha: @fecha) %>
          <p class="mt-3 text-lg font-semibold text-slate-900">
            <%= moneda(prep.costo_total(fecha: @fecha)) %>
          </p>
          <p class="text-xs text-slate-500">
            <%= moneda(prep.costo_por_unidad_base(fecha: @fecha)) %> por <%= prep.unidad_base %>
          </p>
        <% else %>
          <p class="mt-3 text-sm text-amber-700">sin costear</p>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>
