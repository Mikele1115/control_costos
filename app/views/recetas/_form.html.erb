<% clases_campo = "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>

<%= form_with model: receta, class: "space-y-5",
      data: { controller: "tipo-receta" } do |f| %>

  <% if receta.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 p-4">
      <p class="text-sm font-semibold text-rose-900">
        No se pudo guardar (<%= pluralize(receta.errors.count, "error") %>)
      </p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-rose-800">
        <% receta.errors.full_messages.each do |mensaje| %>
          <li><%= mensaje %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :nombre, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :nombre, class: clases_campo, autofocus: true %>
  </div>

  <div>
    <%= f.label :tipo, class: "block text-sm font-medium text-slate-700" %>
    <%= f.select :tipo,
          Receta::TIPOS.map { |tipo| [t("costeo.tipos.#{tipo}"), tipo] },
          {},
          class: clases_campo,
          data: { tipo_receta_target: "tipo",
                  action: "change->tipo-receta#actualizar" } %>
  </div>

  <div data-tipo-receta-target="plato" class="space-y-5 rounded-lg bg-slate-50 p-4">
    <div>
      <%= f.label :categoria, "Sección de la carta", class: "block text-sm font-medium text-slate-700" %>
      <%= f.select :categoria,
            Receta::CATEGORIAS.map { |c| [t("costeo.categorias.#{c}"), c] },
            { include_blank: "Sin clasificar" }, class: clases_campo %>
    </div>

    <div>
      <%= f.label :precio_venta, "Precio de venta", class: "block text-sm font-medium text-slate-700" %>
      <%= f.number_field :precio_venta, step: "0.01", min: 0, class: clases_campo %>
      <p class="mt-1 text-xs text-slate-500">Necesario para calcular el food cost.</p>
    </div>
  </div>

  <div data-tipo-receta-target="preparacion" class="space-y-5 rounded-lg bg-slate-50 p-4">
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :rendimiento_cantidad, "¿Cuánto rinde?", class: "block text-sm font-medium text-slate-700" %>
        <%= f.number_field :rendimiento_cantidad, step: "0.0001", min: 0, class: clases_campo %>
      </div>
      <div>
        <%= f.label :rendimiento_unidad, "Unidad", class: "block text-sm font-medium text-slate-700" %>
        <%= f.select :rendimiento_unidad,
              Unidad.todas.map { |u| [t("costeo.unidades.#{u}"), u] },
              { include_blank: "Elegir..." }, class: clases_campo %>
      </div>
    </div>
    <p class="text-xs text-slate-500">
      De aquí sale su costo unitario: si rinde 2000 g y cuesta $8.000,
      vale $4 por gramo cuando la uses en un plato.
    </p>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
    <%= link_to "Cancelar", receta.persisted? ? receta : recetas_path,
          class: "text-sm text-slate-500 hover:underline" %>
  </div>
<% end %>
